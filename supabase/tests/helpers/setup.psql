-- Shared set-up for the pgTAP files. Everything here sits inside the test's
-- transaction and is rolled back with it.
create extension if not exists pgtap with schema extensions;
set search_path = public, extensions;

create schema if not exists t;
grant usage on schema t to anon, authenticated, service_role;

-- A player of a given age, with the rows the sign-up trigger makes.
create function t.player(p_id uuid, p_age int default 30, p_country text default 'SG')
returns uuid language plpgsql security definer as $$
begin
  insert into auth.users (id, instance_id, aud, role, email)
  values (p_id, '00000000-0000-0000-0000-000000000000', 'authenticated', 'authenticated',
    p_id::text || '@test.local');
  update public.account_private
  set mobile = '+65' || lpad((('x' || substr(md5(p_id::text), 1, 8))::bit(32)::bigint % 100000000)::text, 8, '0'),
      mobile_verified_at = now()
  where id = p_id;
  if p_age is not null then
    update public.account_private
    set birthday = (now() at time zone 'Asia/Singapore')::date
          - make_interval(years => p_age) - interval '1 day',
        country_code = p_country
    where id = p_id;
  end if;
  update public.profiles set full_name = 'Test Player', username = 'p' || right(replace(p_id::text, '-', ''), 20),
    onboarding_completed = true where id = p_id;
  return p_id;
end;
$$;

-- Acts as a signed-in player until t.reset().
create function t.as_user(p_id uuid) returns void language plpgsql as $$
begin
  perform set_config('request.jwt.claims',
    json_build_object('sub', p_id, 'role', 'authenticated')::text, true);
  perform set_config('role', 'authenticated', true);
end;
$$;

create function t.as_anon() returns void language plpgsql as $$
begin
  perform set_config('request.jwt.claims', json_build_object('role', 'anon')::text, true);
  perform set_config('role', 'anon', true);
end;
$$;

create function t.reset() returns void language plpgsql as $$
begin
  perform set_config('role', 'postgres', true);
  perform set_config('request.jwt.claims', '', true);
  perform set_config('request.path', '', true);
  perform set_config('request.method', '', true);
end;
$$;

-- A Meet starting in p_hours, hosted by p_host.
create function t.meet(p_host uuid, p_capacity int default 4, p_hours int default 48,
  p_min int default null, p_sport text default 'badminton', p_game text default 'doubles')
returns uuid language plpgsql security definer as $$
declare
  v_id uuid;
begin
  insert into public.activities (kind, host_id, title, sports, game_type, format,
    starts_at, ends_at, venue_id, capacity, min_players)
  select 'meet', p_host, 'Test Meet', array[p_sport], p_game, 'open_play',
    now() + make_interval(hours => p_hours), now() + make_interval(hours => p_hours + 2),
    v.id, p_capacity, p_min
  from public.venues v order by v.name limit 1
  returning id into v_id;
  return v_id;
end;
$$;

-- Moves a Meet to just before its start, which opens attendance. Not after
-- the start: run just past midnight that would be yesterday, and closed.
create function t.start_meet(p_id uuid) returns void language sql security definer as $$
  update public.activities
  set starts_at = now() + interval '5 minutes', ends_at = now() + interval '2 hours'
  where id = p_id;
$$;

create function t.status_of(p_activity uuid, p_user uuid) returns text
language sql security definer as $$
  select status from public.activity_participants
  where activity_id = p_activity and user_id = p_user;
$$;

grant execute on all functions in schema t to anon, authenticated, service_role;

-- A staff member, signed in with (default) or without MFA.
create function t.as_staff(p_id uuid, p_mfa boolean default true) returns void language plpgsql as $$
begin
  perform set_config('request.jwt.claims', json_build_object('sub', p_id, 'role', 'authenticated',
    'aal', case when p_mfa then 'aal2' else 'aal1' end)::text, true);
  perform set_config('role', 'authenticated', true);
end;
$$;
grant execute on function t.as_staff(uuid, boolean) to anon, authenticated, service_role;
