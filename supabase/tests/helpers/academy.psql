-- Shared set-up for the academy tests. Everything rolls back with the test.

create function t.licence(p_user uuid, p_expires date default current_date + 365) returns void
language sql security definer as $$
  insert into public.coach_licences (user_id, nroc_number, expires_on, status, verified_at)
  values (p_user, 'NROC-' || left(p_user::text, 8), p_expires, 'verified', now())
  on conflict (user_id) do update set status = 'verified', expires_on = p_expires, verified_at = now();
$$;

-- A verified, open academy with its owner as head coach, ready for bookings.
create function t.academy(p_owner uuid, p_name text default 'Test Academy') returns uuid
language plpgsql security definer as $$
declare
  v_id uuid;
begin
  perform t.licence(p_owner);
  insert into public.vendors (owner_id, stripe_account_id, status, verified_at)
  values (p_owner, 'acct_' || left(replace(p_owner::text, '-', ''), 16), 'verified', now())
  on conflict (owner_id) do update set status = 'verified', verified_at = now();
  insert into public.academies (owner_id, name, sport, verification, uen)
  values (p_owner, p_name, 'badminton', 'verified', '201912345A') returning id into v_id;
  insert into public.academy_coaches (academy_id, user_id, role, head, accepted_at)
  values (v_id, p_owner, 'Head coach', true, now());
  return v_id;
end;
$$;

create function t.coach(p_academy uuid, p_user uuid) returns void language sql security definer as $$
  select t.licence(p_user);
  insert into public.academy_coaches (academy_id, user_id, accepted_at) values (p_academy, p_user, now());
$$;

-- A class that meets every day at 10:00, so any date is a class date.
create function t.class(p_academy uuid, p_coach uuid default null, p_capacity int default 4, p_level int default 1)
returns uuid language sql security definer as $$
  insert into public.academy_classes (academy_id, name, level, weekdays, hour, capacity, coach_id)
  values (p_academy, 'Class ' || left(gen_random_uuid()::text, 6), p_level, '{1,2,3,4,5,6,7}', 10, p_capacity, p_coach)
  returning id;
$$;

create function t.link(p_parent uuid, p_child uuid) returns uuid language sql security definer as $$
  insert into public.guardian_links (child_id, parent_id, status, decided_at)
  values (p_child, p_parent, 'approved', now()) returning id;
$$;

create function t.student(p_class uuid, p_parent uuid, p_player uuid) returns uuid
language sql security definer as $$
  insert into public.academy_students (academy_id, class_id, parent_id, player_id, name, age)
  select c.academy_id, p_class, p_parent, p_player, 'Test Student', 12
  from public.academy_classes c where c.id = p_class returning id;
$$;

-- 10:00 Singapore time, p_days from today.
create function t.class_at(p_days int) returns timestamptz language sql as $$
  select (((now() at time zone 'Asia/Singapore')::date + p_days)::timestamp + time '10:00') at time zone 'Asia/Singapore';
$$;

create function t.upload(p_user uuid, p_name text default 'doc.jpg') returns text language plpgsql security definer as $$
declare
  v_path text := p_user || '/' || p_name;
begin
  insert into storage.objects (bucket_id, name) values ('verification-docs', v_path);
  return v_path;
end;
$$;
